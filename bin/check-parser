#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

cp "$ROOT/event-parser" "$TMP/"
chmod +x "$TMP/event-parser"

OUT="$(
printf '%s\n' \
'texto' \
'<<RETRIEVE SEARCH context-builder>>' |
"$TMP/event-parser"
)"

echo "===== OUTPUT ====="
printf '%s\n' "$OUT"

echo
echo "===== ASSERT ====="

grep -q '^type=TEXT$' <<<"$OUT" && echo "🟢 TEXT" || { echo "🔴 TEXT"; exit 1; }
grep -q '^type=RETRIEVE$' <<<"$OUT" && echo "🟢 RETRIEVE" || { echo "🔴 RETRIEVE"; exit 1; }
grep -q '^verb=SEARCH$' <<<"$OUT" && echo "🟢 VERB" || { echo "🔴 VERB"; exit 1; }
grep -q '^arg=context-builder$' <<<"$OUT" && echo "🟢 ARG" || { echo "🔴 ARG"; exit 1; }

echo
echo "🟢 Parser OK"
