#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

HANDLER="${1:?uso: check-handler <handler> [fixture]}"
FIXTURE="${2:-default}"

ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

mkdir -p "$TMP"
cp -r "$ROOT/handlers" "$TMP/"
chmod +x "$TMP"/handlers/*

if [ -d "$ROOT/fixtures/$FIXTURE" ]; then
    cp -r "$ROOT/fixtures/$FIXTURE"/. "$TMP"/
else
    mkdir -p "$TMP/cache"/{events,sessions,reports,notifications,metrics}

    cat > "$TMP/cache/events/000001.event" <<'EOT'
id=000001
type=TEXT
content=test
EOT
fi

export TERMIRIS_RUNTIME="$TMP"

echo "== Handler =="
echo "$HANDLER"

echo
echo "== Fixture =="
echo "$FIXTURE"

echo
echo "== STDOUT =="

"$TMP/handlers/$HANDLER" "$TMP/cache/events/000001.event" || true

echo
echo "== Artefatos =="

find "$TMP/cache" -type f | sort

echo
echo "== Conteúdo =="

find "$TMP/cache" -type f | sort | while read -r F; do
    echo
    echo "--- ${F#$TMP/}"
    cat "$F"
done
