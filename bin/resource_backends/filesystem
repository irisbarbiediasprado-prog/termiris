#!/usr/bin/env python3
import sys, os, json

try:
    data = json.load(sys.stdin)
    path = data.get("resource", "").replace("filesystem://", "")
    path = os.path.expanduser(path.replace("/home/user", "~"))

    if os.path.exists(path):
        with open(path, "r", encoding="utf-8") as f:
            print(json.dumps({"payload": {"content": f.read()}}))
    else:
        print(json.dumps({"payload": {"error": f"Not found: {path}"}}))
except Exception as e:
    print(json.dumps({"payload": {"error": str(e)}}))
