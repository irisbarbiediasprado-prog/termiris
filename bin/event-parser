#!/usr/bin/env python3
import socket
import re
import subprocess
import sys
from pathlib import Path

SOCKET_PATH = Path.home() / ".termiris" / "runtime" / "parser.sock"
PROTOCOL_HANDLER = Path.home() / ".termiris" / "bin" / "protocol-handler"
LOG_FILE = Path.home() / ".termiris" / "runtime" / "event-parser.log"

ANSI_ESCAPE = re.compile(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])')
PROTOCOL_TAG_RE = re.compile(r'<<\s*([A-Z_]+)(?:\s+([^>]+))?\s*>>')

def log(msg: str):
    with open(LOG_FILE, "a") as f:
        f.write(f"{msg}\n")

def clean_text(text: str) -> str:
    return ANSI_ESCAPE.sub('', text)

def process_line(line: str):
    clean = clean_text(line).strip()
    match = PROTOCOL_TAG_RE.search(clean)
    if match:
        raw_cmd = match.group(0)
        log(f"[Tag detectada]: {raw_cmd}")
        
        # Dispara o handler sem bloquear o loop de leitura do socket
        try:
            p = subprocess.Popen(
                [str(PROTOCOL_HANDLER)],
                stdin=subprocess.PIPE,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                text=True
            )
            p.communicate(input=f"{raw_cmd}\n", timeout=2)
            log("[Protocol handler]: Executado com sucesso.")
        except Exception as e:
            log(f"[Erro no Handler]: {e}")

def main():
    if not SOCKET_PATH.exists():
        log(f"Socket {SOCKET_PATH} nao encontrado.")
        sys.exit(1)

    log(f"Conectando ao socket {SOCKET_PATH}...")
    
    try:
        client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        client.connect(str(SOCKET_PATH))
    except Exception as e:
        log(f"Erro ao conectar no socket: {e}")
        sys.exit(1)

    buffer = ""
    try:
        while True:
            data = client.recv(4096)
            if not data:
                break
            buffer += data.decode('utf-8', errors='ignore')
            while '\n' in buffer:
                line, buffer = buffer.split('\n', 1)
                process_line(line)
    except KeyboardInterrupt:
        pass
    except Exception as e:
        log(f"Erro na conexao: {e}")
    finally:
        client.close()

if __name__ == "__main__":
    main()
