#!/usr/bin/env python3
import socket
import re
import sys
from pathlib import Path

LIB_DIR = Path.home() / ".termiris" / "lib"
if str(LIB_DIR) not in sys.path:
    sys.path.insert(0, str(LIB_DIR))

from protocol.dispatcher import ProtocolRuntime

SOCKET_PATH = Path.home() / ".termiris" / "runtime" / "parser.sock"
LOG_FILE = Path.home() / ".termiris" / "runtime" / "event-parser.log"

ANSI_ESCAPE = re.compile(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])')

runtime = ProtocolRuntime()

def log(msg):
    with open(LOG_FILE, "a", encoding="utf-8") as f:
        f.write(msg + "\n")

def clean(text):
    return ANSI_ESCAPE.sub("", text)

def handle(tag):
    log(f"[Tag detectada]: {tag}")
    try:
        ops = runtime.handle(tag)
        log(f"[ProtocolRuntime]: {len(ops)} operacoes processadas.")
    except Exception as e:
        log(f"[Erro no ProtocolRuntime]: {e}")

def main():
    if not SOCKET_PATH.exists():
        log(f"Socket {SOCKET_PATH} nao encontrado.")
        sys.exit(1)

    log(f"Conectando ao socket {SOCKET_PATH}...")

    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.connect(str(SOCKET_PATH))

    buffer = ""

    try:
        while True:
            data = client.recv(4096)
            if not data:
                break

            buffer += clean(data.decode("utf-8", errors="ignore"))

            while True:
                start = buffer.find("<<")
                if start < 0:
                    buffer = buffer[-1:] if buffer.endswith("<") else ""
                    break

                end = buffer.find(">>", start + 2)
                if end < 0:
                    buffer = buffer[start:]
                    break

                tag = buffer[start:end + 2]
                buffer = buffer[end + 2:]

                handle(tag)

    except KeyboardInterrupt:
        pass
    except Exception as e:
        log(f"Erro: {e}")
    finally:
        client.close()

if __name__ == "__main__":
    main()
