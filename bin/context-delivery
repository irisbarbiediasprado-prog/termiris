#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

STATE_DIR="$HOME/.termiris/runtime/cache/state"
SNAPSHOT="$STATE_DIR/snapshot.ctx"
META="$STATE_DIR/snapshot.meta"
SESSION_STATE="$HOME/.termiris/runtime/cache/sessions/state"

SESSION="ia_chat"
TARGET="ia_chat:Chat*"

MAX_RETRIES=5
BASE_BACKOFF=2
MAX_BACKOFF=60

mkdir -p "$STATE_DIR"

get_snapshot_hash() {
    [ -f "$META" ] || return 0
    grep '^snapshot_hash=' "$META" | cut -d= -f2 || true
}

deliver() {
    local hash="$1"
    if ! tmux has-session -t "$SESSION" 2>/dev/null; then
        echo "🔴 [context-delivery] sessão $SESSION inexistente"
        return 1
    fi
    tmux send-keys -t "$TARGET" C-u ".file $SNAPSHOT --hash=$hash" Enter
    echo "🟢 [context-delivery] .file enviado (hash=$hash)"
    return 0
}

read_session_state() {
    [ -f "$SESSION_STATE" ] || return 1
    local status hash updated
    status="$(awk -F= '/^status=/{print $2;exit}' "$SESSION_STATE")"
    hash="$(awk -F= '/^hash=/{print $2;exit}' "$SESSION_STATE")"
    updated="$(awk -F= '/^updated=/{print $2;exit}' "$SESSION_STATE")"
    echo "$status|$hash|$updated"
}

state="IDLE"
pending_hash=""
retry_count=0
retry_at=0
last_success=""
[ -f "$STATE_DIR/last_success" ] && last_success="$(cat "$STATE_DIR/last_success")"

process() {
    case "$state" in
        IDLE)
            local new_hash
            new_hash="$(get_snapshot_hash)"
            if [ -n "$new_hash" ] && [ "$new_hash" != "$last_success" ]; then
                pending_hash="$new_hash"
                retry_count=0
                retry_at=0
                state="SEND"
                echo "📦 [context-delivery] novo snapshot: $new_hash"
            fi
            ;;

        SEND)
            local now
            now=$(date +%s)
            if [ -n "$pending_hash" ] && [ "$retry_at" -le "$now" ]; then
                if deliver "$pending_hash"; then
                    state="WAIT_RESULT"
                    retry_count=$((retry_count + 1))
                    echo "⏳ [context-delivery] aguardando estado (hash=$pending_hash)"
                else
                    retry_at=$((now + 2))
                    echo "⚠️ [context-delivery] falha no envio, retry em 2s"
                fi
            fi
            ;;

        WAIT_RESULT)
            local state_line
            state_line="$(read_session_state || echo "")"
            if [ -z "$state_line" ]; then
                local elapsed
                elapsed=$(($(date +%s) - $(stat -c %Y "$SESSION_STATE" 2>/dev/null || echo 0)))
                if [ $elapsed -gt 120 ]; then
                    retry_count=$((retry_count + 1))
                    if [ $retry_count -le $MAX_RETRIES ]; then
                        local backoff=$((BASE_BACKOFF * (2 ** (retry_count - 1))))
                        [ $backoff -gt $MAX_BACKOFF ] && backoff=$MAX_BACKOFF
                        retry_at=$(($(date +%s) + backoff))
                        state="SEND"
                        echo "🔄 [context-delivery] timeout, retry em ${backoff}s (tentativa $retry_count)"
                    else
                        echo "❌ [context-delivery] timeout excedido"
                        state="IDLE"
                        pending_hash=""
                        retry_count=0
                        retry_at=0
                    fi
                fi
                return
            fi

            IFS='|' read -r status hash updated <<< "$state_line"
            if [ "$hash" != "$pending_hash" ]; then
                return
            fi

            case "$status" in
                PASS|SUCCESS|OK)
                    echo "✅ [context-delivery] sucesso para hash $pending_hash"
                    echo "$pending_hash" > "$STATE_DIR/last_success"
                    last_success="$pending_hash"
                    state="IDLE"
                    pending_hash=""
                    retry_count=0
                    retry_at=0
                    ;;

                TEMP_ERROR|RETRY)
                    retry_count=$((retry_count + 1))
                    if [ $retry_count -le $MAX_RETRIES ]; then
                        local backoff=$((BASE_BACKOFF * (2 ** (retry_count - 1))))
                        [ $backoff -gt $MAX_BACKOFF ] && backoff=$MAX_BACKOFF
                        retry_at=$(($(date +%s) + backoff))
                        state="SEND"
                        echo "⚠️ [context-delivery] erro temporário, retry em ${backoff}s (tentativa $retry_count)"
                    else
                        echo "❌ [context-delivery] máximo de tentativas excedido"
                        state="IDLE"
                        pending_hash=""
                        retry_count=0
                        retry_at=0
                    fi
                    ;;

                FAIL|ERROR|PERM_ERROR)
                    echo "❌ [context-delivery] erro permanente para hash $pending_hash"
                    state="IDLE"
                    pending_hash=""
                    retry_count=0
                    retry_at=0
                    ;;

                *)
                    echo "⚠️ [context-delivery] status desconhecido: $status"
                    ;;
            esac
            ;;
    esac
}

echo "👁️ [context-delivery] com --hash no protocolo (PID $$)"

while true; do
    process
    if [ "$state" = "IDLE" ] || [ "$state" = "SEND" ]; then
        if command -v inotifywait >/dev/null 2>&1; then
            inotifywait -q -t 1 -e close_write,moved_to "$META" 2>/dev/null || true
        else
            sleep 0.2
        fi
    elif [ "$state" = "WAIT_RESULT" ]; then
        if command -v inotifywait >/dev/null 2>&1; then
            inotifywait -q -t 5 -e close_write "$SESSION_STATE" 2>/dev/null || true
        else
            sleep 0.5
        fi
    else
        sleep 0.1
    fi
done
