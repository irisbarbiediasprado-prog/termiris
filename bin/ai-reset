#!/data/data/com.termux/files/usr/bin/bash
set -uo pipefail

SESSION="ia_chat"
STATE_DIR="$HOME/.termiris/runtime/cache/state"
TARGET="ia_chat:Chat"

echo "== ai-reset start =="

# Sair de ia_chat se estiver dentro
if [ -n "${TMUX:-}" ]; then
  cur="$(tmux display-message -p '#S' 2>/dev/null || true)"
  if [ "$cur" = "$SESSION" ]; then
    tmux has-session -t main 2>/dev/null || tmux new-session -d -s main
    tmux switch-client -t main 2>/dev/null || true
    sleep 0.3
  fi
fi

# Mata APENAS processos do Termiris (não tmux)
pkill -x event-parser 2>/dev/null || true
pkill -f "mitl" 2>/dev/null || true
pkill -f "context-delivery" 2>/dev/null || true
pkill -x termiris-chat 2>/dev/null || true
pkill -x aichat 2>/dev/null || true

tmux kill-session -t "$SESSION" 2>/dev/null || true
sleep 0.3

mkdir -p "$STATE_DIR"
find "$STATE_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true

# Inicia o runtime (sem espera bloqueante)
echo "== creating Chat =="
tmux new-session -d -s "$SESSION" -n Chat \
  "bash $HOME/.termiris/bin/termiris-chat termiris_ctx; echo EXIT=\$?; sleep infinity"

sleep 1

if ! tmux has-session -t "$SESSION" 2>/dev/null; then
  echo "FAIL: session not created"
  exit 1
fi
echo "OK: session exists"

echo "== waiting prompt =="
ready=0
for i in $(seq 1 40); do
  if tmux capture-pane -pt "$TARGET" 2>/dev/null | grep -q "termiris_ctx)"; then
    echo "OK: prompt ready"
    ready=1
    break
  fi
  sleep 0.25
done
[ "$ready" = 1 ] || echo "WARN: prompt timeout"

echo "== bootstrap =="
echo "<< BOOTSTRAP >>" | "$HOME/.termiris/bin/ai-protocol" 2>/dev/null || echo "WARN: bootstrap failed"

echo "== aux windows =="
tmux new-window -t "$SESSION" -n Project "$HOME/.termiris/bin/context-delivery" 2>/dev/null || true
tmux new-window -t "$SESSION" -n Context -c "$HOME/.termiris" \
  "watch -n 1 'cat runtime/cache/state/snapshot.ctx 2>/dev/null || echo Sem Contexto'" 2>/dev/null || true

tmux select-window -t "$SESSION:Chat" 2>/dev/null || true

echo "== done =="
tmux list-sessions
tmux list-windows -t "$SESSION"
echo "Entre com: tmux switch-client -t ia_chat"
