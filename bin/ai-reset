#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

SESSION="ia_chat"
STATE_DIR="$HOME/.termiris/runtime/cache/state"

# 1. Garante que os diretórios físicos essenciais SEMPRE existem
mkdir -p "$STATE_DIR"

# 2. Limpa daemons e sockets antigos
pkill -f "event-parser" 2>/dev/null || true
pkill -f "mitl" 2>/dev/null || true
rm -f "$HOME/.termiris/runtime/parser.sock"
rm -f "$HOME/.termiris/runtime/event-parser.log"

# 3. Mata a sessão do tmux de forma segura
tmux kill-session -t "$SESSION" 2>/dev/null || true

# 4. Reseta o snapshot em memória/disco
rm -f "$STATE_DIR"/*

# 5. RE-BOOTSTRAP ATÔMICO VIA PROTOCOL RUNTIME
echo "<< BOOTSTRAP >>" | "$HOME/.termiris/bin/ai-protocol" 2>/dev/null || true

# 6. Reconstrói a sessão do tmux do zero
tmux new-session -d -s "$SESSION" -n Chat \
'sh -c "$HOME/.termiris/bin/termiris-chat termiris_ctx 2>&1 | tee -a $HOME/.termiris/runtime/mitl.stdout.log; rc=\${PIPESTATUS:-\$?}; echo; echo \"=== MITL FINALIZOU (exit=\$rc) ===\"; read -r -p \"ENTER para fechar...\" _"'
tmux new-window -t "$SESSION" -n Project \
    "$HOME/.termiris/bin/project-monitor"

tmux new-window -t "$SESSION" -n Context -c "$HOME/.termiris" \
    "watch -n 1 'cat runtime/cache/state/snapshot.ctx 2>/dev/null || echo Sem Contexto Ativo'"

tmux select-window -t "$SESSION:Chat"

# 7. Anexa ou alterna de forma segura
if [ -z "${TMUX:-}" ]; then
    tmux attach-session -t "$SESSION"
else
    tmux switch-client -t "$SESSION"
fi

echo "🟢 Termiris resetado com sucesso para Gen 1 via ProtocolRuntime"
