#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="$HOME/.termiris/runtime"
SB="$ROOT/.sandbox"

rm -rf "$SB"
mkdir -p "$SB/cache/events"

cp "$ROOT/event-bus" "$SB/"
cp -r "$ROOT/handlers" "$SB/"

find "$SB" -type f -exec chmod +x {} +

: > "$SB/cache/events/.seq"

export TERMIRIS_RUNTIME="$SB"
export TERMIRIS_DEBUG=1

printf '%s\n' \
'id=000001' \
'type=TEXT' \
'content=teste' |
"$SB/event-bus"

echo
echo "=== TREE ==="
find "$SB" -type f | sort

echo
echo "=== DEBUG ==="
cat "$SB/cache/event-bus.debug"
