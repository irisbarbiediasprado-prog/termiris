#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="${TERMIRIS_ROOT:-$HOME/.termiris}"

usage() {
cat <<USAGE
Uso:
  retrieve FILE <arquivo>...
  retrieve SEARCH <texto>
USAGE
}

[ $# -ge 2 ] || { usage; exit 1; }

TYPE="$1"
shift

case "$TYPE" in

FILE)

echo "BEGIN RETRIEVE"
echo
echo "STATUS: OK"
echo

FOUND=0

for FILE in "$@"; do
    [ -f "$ROOT/$FILE" ] || continue

    FOUND=1

    echo "FILE: $FILE"
    echo
    cat "$ROOT/$FILE"
    echo
    echo "END FILE"
    echo
done

if [ "$FOUND" -eq 0 ]; then
    echo "STATUS: ERROR"
    echo
    echo "ERROR: FILE_NOT_FOUND"
    echo
fi

echo "END RETRIEVE"
;;

SEARCH)

QUERY="$*"

echo "BEGIN SEARCH"
echo
echo "STATUS: OK"
echo

RESULTS="$(
{
    fd --hidden --follow "$QUERY" "$ROOT" 2>/dev/null
    rg -l --hidden --glob '!.git' "$QUERY" "$ROOT" 2>/dev/null
} | sed "s|^$ROOT/||" | sort -u
)"

if [ -z "$RESULTS" ]; then
    echo "STATUS: ERROR"
    echo
    echo "ERROR: EMPTY_RESULT"
    echo
else
    printf '%s\n' "$RESULTS"
fi

echo
echo "END SEARCH"
;;

*)

usage
exit 1
;;

esac
