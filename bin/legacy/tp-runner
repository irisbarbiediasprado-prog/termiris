#!/usr/bin/env bash
set -euo pipefail

LESSON="${1:-TP-001}"
PROMPT_FILE="protocol/tests/${LESSON}.prompt"
TARGET_FILE="${HOME}/.termiris/cache/context/context.md"

if [ -f "$PROMPT_FILE" ]; then
    mkdir -p "$(dirname "$TARGET_FILE")"
    cat "$PROMPT_FILE" > "$TARGET_FILE"
    echo "=== $TARGET_FILE ==="
    cat "$TARGET_FILE"
else
    echo "Erro: Arquivo $PROMPT_FILE nao encontrado." >&2
    exit 1
fi
