#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

TESTS=(
    check-parser
    check-event-bus
    "check-handler logger-handler"
    "check-handler retrieve-handler"
    "check-handler tp-handler tp-pass"
    "check-handler report-handler tp-pass"
    "check-handler notify-handler tp-pass"
    "check-handler metrics-handler tp-pass"
    "check-handler replay-handler tp-pass"
    check-runtime
)

PASS=0
FAIL=0

for T in "${TESTS[@]}"; do
    printf "\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    printf "▶ %s\n" "$T"

    if bash -lc "$HOME/.termiris/bin/$T" >/dev/null 2>&1; then
        printf "🟢 PASS\n"
        PASS=$((PASS+1))
    else
        printf "🔴 FAIL\n"
        FAIL=$((FAIL+1))
    fi
done

printf "\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
printf "Total : %d\n" $((PASS+FAIL))
printf "PASS  : %d\n" "$PASS"
printf "FAIL  : %d\n" "$FAIL"

[ "$FAIL" -eq 0 ]
