#!/data/data/com.termux/files/usr/bin/bash
"""
TERMIRIS EVENT BUS v1
STATUS: FROZEN

CONTRATO:
  Entrada:
    - Stream de eventos chave-valor no stdin vindo do event-parser.
  Saída / Processamento:
    - Persiste cada evento em cache/events/<seq>.event.
    - Despacha o arquivo do evento para todos os executáveis em handlers/<type>/.
  Contrato de Handlers:
    - Assinatura: handler <caminho_do_arquivo_event>
    - stdout: reservado EXCLUSIVAMENTE para novos eventos em cascata.
    - stderr: reservado para logs de auditoria e debug.
    - Invariantes: Handlers nunca chamam outros handlers, nunca alteram .seq e não modificam .event existentes.
"""
set -euo pipefail

: "${TERMIRIS_RUNTIME:=$(cd "$(dirname "$0")/.." && pwd)}"
ROOT="$TERMIRIS_RUNTIME"

MAX_DEPTH=5
DEBUG="${TERMIRIS_DEBUG:-0}"

debug() {
    [ "$DEBUG" = "1" ] || return 0
    printf '%s\n' "$*" >> "$ROOT/cache/event-bus.debug"
}

# Abstração para ler propriedades sem acoplar o parser ao awk direto
event_get() {
    local key="$1"
    local file="$2"
    awk -F= -v k="$key" '$1 == k {print $2; exit}' "$file"
}

# TODO: Substituir por flock/trava atômica no arquivo .seq quando existir concorrência de múltiplos Event Bus
next_seq() {
    local n
    seq="$(cat "$ROOT/cache/events/.seq" 2>/dev/null || echo 0)"
    n=$((10#$seq + 1))
    printf '%06d' "$n" > "$ROOT/cache/events/.seq"
    printf '%06d' "$n"
}

process_event() {
    local payload="$1"
    local parent_id="${2:-}"
    local depth="${3:-0}"

    if [ "$depth" -ge "$MAX_DEPTH" ]; then
        debug "ERROR: Recursion limit reached (depth=$depth)"
        return 1
    fi

    local seq_id="$(next_seq)"
    local event_file="$ROOT/cache/events/${seq_id}.event"

    # Persiste o arquivo do evento
    printf '%s\n' "$payload" > "$event_file"
    if [ -n "$parent_id" ]; then
        printf 'parent_id=%s\ndepth=%d\n' "$parent_id" "$depth" >> "$event_file"
    else
        printf 'depth=%d\n' "$depth" >> "$event_file"
    fi

    # Recupera o tipo de forma abstrata
    local type_raw
    type_raw="$(event_get "type" "$event_file")"
    
    if [ -z "$type_raw" ]; then
        debug "WARN: Event without type on $event_file"
        return 0
    fi

    local type_dir="${type_raw,,}"
    debug "EVENT seq=$seq_id type=$type_dir depth=$depth"

    local handler_dir="$ROOT/handlers/$type_dir"
    if [ ! -d "$handler_dir" ]; then
        debug "NO_HANDLER_DIR: $handler_dir"
        return 0
    fi

    # Dispatcher com ordenação determinística independente do locale
    while IFS= read -r handler; do
        [ -n "$handler" ] || continue
        
        debug "RUN $(basename "$handler")"

        local out
        # Executa o handler (capturando stdout para novos eventos)
        out="$("$handler" "$event_file")" || debug "HANDLER_ERROR $?"

        # Re-enfileira novos eventos se houver saída no stdout
        if [ -n "$out" ]; then
            local block=""
            while IFS= read -r line; do
                if [ -z "$line" ]; then
                    [ -z "$block" ] || process_event "$block" "$seq_id" $((depth + 1))
                    block=""
                    continue
                fi
                if [ -z "$block" ]; then
                    block="$line"
                else
                    block="$block"$'\n'"$line"
                fi
            done <<< "$out"
            [ -z "$block" ] || process_event "$block" "$seq_id" $((depth + 1))
        fi
    done < <(find "$handler_dir" -maxdepth 1 -type f -executable | LC_ALL=C sort)
}

# Loop de leitura do stdin (blocos chave-valor delimitados por linha em branco)
block=""
while IFS= read -r line || [ -n "$line" ]; do
    if [ -z "$line" ]; then
        [ -z "$block" ] || process_event "$block" "" 0
        block=""
        continue
    fi

    if [ -z "$block" ]; then
        block="$line"
    else
        block="$block"$'\n'"$line"
    fi
done
[ -z "$block" ] || process_event "$block" "" 0
