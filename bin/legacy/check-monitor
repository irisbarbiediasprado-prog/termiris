#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

WATCH="$HOME/.termiris/cache/mitl-middleman"
CHAT="ia_chat:Chat"

mkdir -p "$WATCH"

echo "🤖 Monitor iniciado"

inotifywait -m \
    -e close_write \
    -e moved_to \
    -e create \
    --format '%w%f' \
    "$WATCH" |
while read -r FILE; do

    [ -f "$FILE" ] || continue

    echo "📥 $(basename "$FILE")"

    tmux pipe-pane -I -t "$CHAT" \
        "printf '.file %s\r' '$FILE'"

    echo "✅ $(basename "$FILE")"

done
