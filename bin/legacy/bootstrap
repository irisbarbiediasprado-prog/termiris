#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="$HOME/.termiris"

STATE="$ROOT/state/bootstrap.state"
CARDS="$ROOT/protocol/bootstrap"
CONTEXT="$ROOT/cache/context/context.md"

mkdir -p "$(dirname "$STATE")" \
         "$(dirname "$CONTEXT")"

publish() {

    CURRENT="$(
    awk '
    /^current:/{
        print $2
    }' "$STATE"
    )"

    CARD="$(
    find "$CARDS" -maxdepth 1 -name '*.card' |
    sort |
    sed -n "$((CURRENT+1))p"
    )"

    [ -f "$CARD" ] || {
        echo "❌ card inexistente"
        exit 1
    }

    cp "$CARD" "$CONTEXT"

    echo "🟢 $(basename "$CARD")"
}

next() {

    awk '
    /^current:/{
        print "current: " $2+1
        next
    }
    {
        print
    }
    ' "$STATE" > "$STATE.tmp"

    mv "$STATE.tmp" "$STATE"

    publish
}

reset() {

    cat > "$STATE" <<STATE
current: 0
STATE

    publish
}

complete() {

    next
}

case "${1:-}" in

publish)

    publish
    ;;

reset)

    reset
    ;;

next)

    next
    ;;

complete)

    complete "${2:-}"
    ;;

*)

echo "usage:"
echo
echo " bootstrap publish"
echo " bootstrap reset"
echo " bootstrap next"
echo " bootstrap complete <step>"
exit 1

;;

esac
