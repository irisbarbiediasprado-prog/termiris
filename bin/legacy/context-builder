#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"
STORE="$ROOT/cache/context"
SESSIONS="$ROOT/cache/sessions"

mkdir -p "$STORE"

usage() {
cat <<USAGE
Usage:
  context-builder gc
USAGE
}

mark() {
    local ID="$1"
    local FILE="$STORE/$ID.ctx"

    [ -f "$FILE" ] || return
    [ -f "$STORE/.mark.$ID" ] && return

    : > "$STORE/.mark.$ID"

    awk '
    /^parents:/{
        for(i=2;i<=NF;i++) print $i
    }' "$FILE" |
    while read -r P; do
        [ -n "$P" ] || continue
        mark "$P"
    done
}

gc() {

    rm -f "$STORE"/.mark.*

    find "$SESSIONS" -type f 2>/dev/null |
    while read -r SESSION; do

        awk '
        /^context:/{
            print $2
        }' "$SESSION" |
        while read -r ID; do
            [ -n "$ID" ] || continue
            mark "$ID"
        done

    done

    REMOVED=0

    find "$STORE" -maxdepth 1 -name '*.ctx' |
    while read -r FILE; do

        ID="$(basename "$FILE" .ctx)"

        if [ ! -f "$STORE/.mark.$ID" ]; then
            rm -f "$FILE"
            echo "GC $ID"
            REMOVED=$((REMOVED+1))
        fi

    done

    rm -f "$STORE"/.mark.*

    echo "GC DONE"
}

case "${1:-}" in

gc)
    gc
    ;;

*)

exec "$HOME/.termiris/bin/context-builder.old" "$@"

;;

esac
