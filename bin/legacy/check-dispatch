#!/data/data/com.termux/files/usr/bin/bash
ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"

echo "ROOT=$ROOT"
echo

echo "TEXT handlers:"
find "$ROOT/handlers/TEXT" -maxdepth 1 -type f -printf '%f\n'

echo
echo "Executáveis:"
find "$ROOT/handlers/TEXT" -maxdepth 1 -type f -executable -printf '%f\n'
