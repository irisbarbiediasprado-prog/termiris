#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

EVENTS="$HOME/.termiris/cache/events"
OUT="$HOME/.termiris/cache/mitl-middleman"

mkdir -p "$EVENTS" "$OUT"

echo "🟢 retrieve-handler"

inotifywait -m \
    -e close_write \
    -e moved_to \
    -e create \
    --format '%w%f' \
    "$EVENTS" |
while IFS= read -r EVENT; do

    [ -f "$EVENT" ] || continue

    TYPE="$(grep '^type=' "$EVENT" | cut -d= -f2)"

    [ "$TYPE" = "RETRIEVE" ] || continue

    VERB="$(grep '^verb=' "$EVENT" | cut -d= -f2)"
    ARG="$(grep '^arg=' "$EVENT" | cut -d= -f2-)"

    ~/.termiris/bin/retrieve "$VERB" "$ARG" \
        > "$OUT/$(basename "$ARG")"

done
