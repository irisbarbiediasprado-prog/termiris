#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"
STORE="$ROOT/cache/context"

mkdir -p "$STORE"

usage() {
cat <<USAGE
Usage:
  context-builder push <payload.ctx> [parent...]
  context-builder get <id>
  context-builder list
  context-builder graph <id>
  context-builder verify <id>
USAGE
}

calc_id() {
    sha256sum "$1" | awk '{print $1}'
}

graph() {
    local ID="$1"
    local PREFIX="${2:-}"
    local FILE="$STORE/$ID.ctx"

    [ -f "$FILE" ] || return

    echo "${PREFIX}${ID:0:12}"

    awk '
    /^parents:/{
        for(i=2;i<=NF;i++) print $i
    }' "$FILE" |
    while read -r P; do
        [ -n "$P" ] || continue
        graph "$P" "  "
    done
}

case "${1:-}" in

push)

PAYLOAD="$2"
shift 2

TMP="$(mktemp)"

{
    echo "version: 1"

    printf "parents:"
    for P in "$@"; do
        printf " %s" "$P"
    done
    echo
    echo

    cat "$PAYLOAD"
} > "$TMP"

ID="$(calc_id "$TMP")"

{
    echo "id: $ID"
    cat "$TMP"
} > "$STORE/$ID.ctx"

rm -f "$TMP"

echo "$ID"
;;

get)

cat "$STORE/$2.ctx"
;;

list)

find "$STORE" -maxdepth 1 -name '*.ctx' \
| xargs -n1 basename \
| sed 's/\.ctx$//' \
| sort
;;

graph)

graph "$2"
;;

verify)

REAL="$(calc_id "$STORE/$2.ctx")"

if [ "$REAL" = "$2" ]; then
    echo PASS
else
    echo FAIL
    exit 1
fi
;;

*)

usage
exit 1
;;

esac
