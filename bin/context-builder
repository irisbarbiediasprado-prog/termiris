#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"
STORE="$ROOT/cache/context"

mkdir -p "$STORE"

INDEX="$STORE/index"

touch "$INDEX"

usage() {
cat <<USAGE
Usage:
  context-builder push <arquivo.ctx>
  context-builder get <id>
  context-builder list
  context-builder verify <id>
USAGE
}

case "${1:-}" in

push)

CTX="$2"

SHA="$(sha256sum "$CTX" | cut -d' ' -f1)"

if grep -q " $SHA$" "$INDEX"; then
    cut -d' ' -f1 "$INDEX" | grep "$(grep " $SHA$" "$INDEX" | cut -d' ' -f1)"
    exit 0
fi

ID=$(printf '%06d' "$(($(wc -l < "$INDEX")+1))")

cp "$CTX" "$STORE/$ID.ctx"

printf '%s %s\n' "$ID" "$SHA" >> "$INDEX"

echo "$ID"
;;

get)

cat "$STORE/$2.ctx"
;;

list)

cat "$INDEX"
;;

verify)

SHA1="$(sha256sum "$STORE/$2.ctx" | cut -d' ' -f1)"
SHA2="$(awk -v id="$2" '$1==id{print $2}' "$INDEX")"

[ "$SHA1" = "$SHA2" ] && {
    echo PASS
    exit 0
}

echo FAIL
exit 1
;;

*)

usage
exit 1
;;

esac
