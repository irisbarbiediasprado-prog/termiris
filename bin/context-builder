#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"
STORE="$ROOT/cache/context"
INDEX="$STORE/index"

mkdir -p "$STORE"
touch "$INDEX"

usage() {
cat <<USAGE
Usage:
  context-builder push <arquivo.ctx> [parent...]
  context-builder get <id>
  context-builder list
  context-builder verify <id>
  context-builder graph <id>
USAGE
}

graph() {
    local ID="$1"
    local PREFIX="${2:-}"

    [ -f "$STORE/$ID.ctx" ] || return

    echo "${PREFIX}${ID}"

    local PARENTS
    PARENTS="$(
        awk '
        /^parents:/{
            for(i=2;i<=NF;i++) print $i
        }' "$STORE/$ID.ctx"
    )"

    [ -z "$PARENTS" ] && return

    while IFS= read -r P; do
        [ -n "$P" ] || continue
        graph "$P" "  "
    done <<< "$PARENTS"
}

case "${1:-}" in

push)

CTX="$2"
shift 2

SHA="$(sha256sum "$CTX" | cut -d' ' -f1)"

if grep -q " $SHA$" "$INDEX"; then
    awk -v sha="$SHA" '$2==sha{print $1;exit}' "$INDEX"
    exit 0
fi

ID=$(printf '%06d' "$(($(wc -l < "$INDEX")+1))")

{
    echo "id: $ID"
    echo "sha256: $SHA"

    if [ "$#" -gt 0 ]; then
        printf 'parents:'
        for P in "$@"; do
            printf ' %s' "$P"
        done
        echo
    else
        echo "parents:"
    fi

    echo
    cat "$CTX"
} > "$STORE/$ID.ctx"

printf '%s %s\n' "$ID" "$SHA" >> "$INDEX"

echo "$ID"
;;

get)

cat "$STORE/$2.ctx"
;;

list)

cat "$INDEX"
;;

verify)

REAL="$(sha256sum "$STORE/$2.ctx" | cut -d' ' -f1)"
STORED="$(awk -v id="$2" '$1==id{print $2}' "$INDEX")"

[ "$REAL" = "$STORED" ] && {
    echo PASS
    exit 0
}

echo FAIL
exit 1
;;

graph)

graph "$2"
;;

*)

usage
exit 1
;;

esac
