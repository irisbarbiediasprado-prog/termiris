#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"
CTX="$ROOT/cache/context"

mkdir -p "$CTX"

case "${1:-}" in

--pack)

shift

ID=$(printf '%06d' "$(($(ls "$CTX" 2>/dev/null | wc -l)+1))")

cat > "$CTX/$ID.ctx"

echo "$CTX/$ID.ctx"
;;

--payload)

awk '
/^payload:[[:space:]]*\|/{f=1;next}
f{print}
' "$2"
;;

*)

echo "usage:"
echo "  context-builder --pack"
echo "  context-builder --payload arquivo.ctx"
exit 1
;;

esac
