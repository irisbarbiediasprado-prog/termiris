#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"
STORE="$ROOT/cache/context"

mkdir -p "$STORE"

usage() {
cat <<USAGE
Usage:
  context-builder push <payload.ctx> [parent...]
  context-builder get <id>
  context-builder list
  context-builder graph <id>
  context-builder verify <id>
  context-builder replay <id>
USAGE
}

calc_id() {
    sha256sum "$1" | awk '{print $1}'
}

graph() {
    local ID="$1"
    local PREFIX="${2:-}"
    local FILE="$STORE/$ID.ctx"

    [ -f "$FILE" ] || return

    echo "${PREFIX}${ID:0:12}"

    awk '
    /^parents:/{
        for(i=2;i<=NF;i++) print $i
    }' "$FILE" |
    while read -r P; do
        [ -n "$P" ] || continue
        graph "$P" "  "
    done
}

replay() {
    local ID="$1"
    local FILE="$STORE/$ID.ctx"

    [ -f "$FILE" ] || return

    awk '
    /^parents:/{
        for(i=2;i<=NF;i++) print $i
    }' "$FILE" |
    while read -r P; do
        [ -n "$P" ] || continue
        replay "$P"
    done

    awk '
    /^payload:[[:space:]]*\|/ {capture=1; next}
    capture {print}
    ' "$FILE"

    echo
}

case "${1:-}" in

replay)
    replay "$2"
    ;;

*)
    exec "$HOME/.termiris/bin/context-builder.old" "$@"
    ;;

esac
