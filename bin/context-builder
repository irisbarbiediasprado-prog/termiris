#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="${TERMIRIS_ROOT:-$HOME/.termiris}"
OUT="$ROOT/cache/context.md"

usage() {
cat <<USAGE
Uso:
  context-builder SEARCH <texto>
  context-builder FILE <arquivo...>

  context-builder --pull <arquivo...>
  context-builder --push
USAGE
exit 1
}

emit_file() {
    local FILE="$1"

    [ -f "$ROOT/$FILE" ] || return

    echo "FILE: $FILE"
    echo
    cat "$ROOT/$FILE"
    echo
}

MODE="${1:-}"
shift || true

case "$MODE" in

SEARCH)

QUERY="$*"

{
    fd --hidden --follow "$QUERY" "$ROOT" 2>/dev/null
    rg -l --hidden --glob '!.git' "$QUERY" "$ROOT" 2>/dev/null
} | sed "s|^$ROOT/||" | sort -u

;;

FILE)

for FILE in "$@"; do
    emit_file "$FILE"
done

;;

--pull)

{
    echo "# Termiris Context"
    echo
    echo "Gerado em: $(date)"
    echo

    for FILE in "$@"; do
        emit_file "$FILE"
    done

} > "$OUT"

echo "🟢 Contexto atualizado"

;;

--push)

"$ROOT/bin/changed-files" | xargs "$0" --pull

;;

*)

usage
;;

esac
