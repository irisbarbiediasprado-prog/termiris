#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="$HOME/.termiris"
TESTS="$ROOT/protocol/tests"
CACHE="$ROOT/cache"

usage() {
cat <<USAGE
Uso:

    tp-test TP-001

USAGE
}

[ $# -eq 1 ] || { usage; exit 1; }

FILE="$TESTS/$1.md"

[ -f "$FILE" ] || {
    echo "❌ Teste não encontrado: $1"
    exit 1
}

mkdir -p "$CACHE"

awk '
BEGIN{mode=""}

/^## Prompt$/{
    mode="prompt"
    next
}

/^## Critérios$/{
    mode="criteria"
    next
}

/^## /{
    mode=""
}

mode=="prompt"{
    print
}
' "$FILE" > "$CACHE/tp-test.md"

echo
echo "=============================="
echo "Teste: $1"
echo "=============================="
echo
echo "Prompt gerado:"
echo
cat "$CACHE/tp-test.md"

echo
echo "------------------------------"
echo "Critérios"
echo "------------------------------"

awk '
BEGIN{mode=""}

/^## Critérios$/{
    mode="criteria"
    next
}

/^## /{
    if(mode=="criteria") exit
}

mode=="criteria"{
    print
}
' "$FILE"

echo
echo ".file $CACHE/tp-test.md"
