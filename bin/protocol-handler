#!/usr/bin/env python3
import sys
from pathlib import Path

# Adiciona lib ao PYTHONPATH
LIB_DIR = Path.home() / ".termiris" / "lib"
sys.path.insert(0, str(LIB_DIR))

from protocol.kernel import CommandRouter, ProtocolKernel
from protocol.isa import PrimitiveISA

def main():
    raw_input = sys.stdin.read().strip()
    if not raw_input:
        sys.exit(0)

    router = CommandRouter()
    router.auto_discover()
    kernel = ProtocolKernel(router)

    try:
        operations = kernel.compile(raw_input)
        for op in operations:
            # Aqui as operações da ISA são entregues de forma declarativa para o Runtime
            print(f"🟢 [ISA OPERAÇÃO EMITIDA]: {op.instruction.name} -> Payload: {op.payload}", file=sys.stderr)
    except Exception as e:
        print(f"❌ [ERRO NO COMPILADOR]: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
