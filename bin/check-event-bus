#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

export TERMIRIS_RUNTIME="$TMP"

mkdir -p "$TMP"

cp "$ROOT"/runtime "$TMP"/
cp "$ROOT"/event-parser "$TMP"/
cp "$ROOT"/event-bus "$TMP"/
cp -r "$ROOT"/handlers "$TMP"/
cp -r "$ROOT"/fixtures "$TMP"/

chmod +x \
    "$TMP/runtime" \
    "$TMP/event-parser" \
    "$TMP/event-bus" \
    "$TMP"/handlers/*

cp -r "$TMP/fixtures/tp-pass/cache" "$TMP/"

printf '%s\n' \
'type=RETRIEVE' \
'verb=SEARCH' \
'arg=context-builder' \
|
"$TMP/event-bus"

echo
echo "========== CHECK EVENT BUS =========="

check() {
    if [ -e "$2" ]; then
        printf "🟢 %-14s %s\n" "$1" "$2"
    else
        printf "🔴 %-14s %s\n" "$1" "$2"
    fi
}

check "EVENT-1" "$TMP/cache/events/000001.event"
check "EVENT-2" "$TMP/cache/events/000002.event"
check "RESULT"  "$TMP/cache/sessions/result"
check "REPORT"  "$TMP/cache/reports/TP-001.md"
check "NOTIFY"  "$(find "$TMP/cache/notifications" -type f 2>/dev/null | head -1)"
check "LOG"     "$TMP/cache/runtime.log"

echo
echo "========== TREE =========="
find "$TMP/cache" -type f | sort
