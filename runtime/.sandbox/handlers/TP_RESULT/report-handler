#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"

SESSION="$ROOT/cache/sessions"
REPORTS="$ROOT/cache/reports"

mkdir -p "$REPORTS"

TP="$(grep '^id=' "$SESSION/current" | cut -d= -f2)"
CTX="$SESSION/context.ctx"

[ -f "$CTX" ] || exit 0

awk '
BEGIN{p=0}
/^payload:[[:space:]]*\|/{p=1;next}
p{sub(/^  /,"");print}
' "$CTX" > "$REPORTS/$TP.md"
