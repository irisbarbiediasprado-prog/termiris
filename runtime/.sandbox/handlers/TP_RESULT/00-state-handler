#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"

EVENT="$1"

TYPE="$(grep '^type=' "$EVENT" | cut -d= -f2)"
[ "$TYPE" = "TP_RESULT" ] || exit 0

SESSION="$ROOT/cache/sessions"

mkdir -p "$SESSION"

cp "$EVENT" "$SESSION/result.event"

EVENT_ID="$(basename "$EVENT" .event)"

cat > "$SESSION/current" <<EOT
id=TP-001
last=$EVENT_ID
EOT
