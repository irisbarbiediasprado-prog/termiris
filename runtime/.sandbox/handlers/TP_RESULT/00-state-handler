#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"

EVENT="$1"

TYPE=
STATUS=
CONTEXT=

while IFS='=' read -r K V; do
    case "$K" in
        type) TYPE="$V" ;;
        status) STATUS="$V" ;;
        context) CONTEXT="$V" ;;
    esac
done < "$EVENT"

[ "$TYPE" = "TP_RESULT" ] || exit 0
[ -f "$CONTEXT" ] || exit 1

SESSION="$ROOT/cache/sessions"

mkdir -p "$SESSION"

cp "$CONTEXT" "$SESSION/context.ctx"

cat > "$SESSION/state" <<EOT
status=$STATUS
context=$SESSION/context.ctx
updated=$(date -Iseconds)
EOT
