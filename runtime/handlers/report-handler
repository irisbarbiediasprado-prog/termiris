#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"

EVENT="$1"

TYPE="$(grep '^type=' "$EVENT" | cut -d= -f2)"
[ "$TYPE" = "TP_RESULT" ] || exit 0

SESSION="$ROOT/cache/sessions/current"
RESULT="$ROOT/cache/sessions/result"
EVENTS="$ROOT/cache/events"
REPORTS="$ROOT/cache/reports"

mkdir -p "$REPORTS"

TEST="$(grep '^id=' "$SESSION" | cut -d= -f2)"
EVENT_ID="$(grep '^event=' "$RESULT" | cut -d= -f2)"
STATUS="$(head -n1 "$RESULT")"

{
echo "# TP Report"
echo
echo "Test: $TEST"
echo
echo "Status: $STATUS"
echo
echo "----------------------------------------"
echo
echo "Session"
cat "$SESSION"
echo
echo "----------------------------------------"
echo
echo "Result"
cat "$RESULT"
echo
echo "----------------------------------------"
echo
echo "Event"
cat "$EVENTS/$EVENT_ID.event"
} > "$REPORTS/$TEST.md"
