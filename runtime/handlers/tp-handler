#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"

EVENT="$1"
SESSION="$ROOT/cache/sessions/current"
RESULT="$ROOT/cache/sessions/result"

mkdir -p "$ROOT/cache/sessions"

[ -f "$SESSION" ] || exit 0

EXPECTED="$(grep '^expect=' "$SESSION" | cut -d= -f2-)"

TYPE=
VERB=
ARG=

while IFS='=' read -r K V; do
    case "$K" in
        type) TYPE="$V" ;;
        verb) VERB="$V" ;;
        arg)  ARG="$V" ;;
    esac
done < "$EVENT"

[ "$TYPE" = "RETRIEVE" ] || exit 0

OBSERVED="$VERB $ARG"

if [ "$OBSERVED" = "$EXPECTED" ]; then
    echo PASS > "$RESULT"
else
    {
        echo FAIL
        echo "expected=$EXPECTED"
        echo "observed=$OBSERVED"
    } > "$RESULT"
fi
