#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"

SESSION="$ROOT/cache/sessions"
NOTIFY="$ROOT/cache/notifications"

CTX="$SESSION/context.ctx"

[ -f "$CTX" ] || exit 0

mkdir -p "$NOTIFY"

ID="$(date +%s)"

cp "$CTX" "$NOTIFY/$ID.notify"

printf 'notification=%s\ncontext=%s\n' \
"$ID" \
"$CTX" > "$NOTIFY/$ID.meta"
