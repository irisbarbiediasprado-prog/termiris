#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"

EVENT="$1"

TYPE="$(grep '^type=' "$EVENT" | cut -d= -f2)"
[ "$TYPE" = "TP_RESULT" ] || exit 0

SESSION="$ROOT/cache/sessions"
REPORTS="$ROOT/cache/reports"

mkdir -p "$REPORTS"

CURRENT="$SESSION/current"
RESULT="$SESSION/result.event"

[ -f "$CURRENT" ] || exit 0
[ -f "$RESULT" ] || exit 0

TEST="$(grep '^id=' "$CURRENT" | cut -d= -f2)"

{
echo "# TP Report"
echo
echo "Test: $TEST"
echo
echo "----------------------------------------"
echo
cat "$CURRENT"
echo
echo "----------------------------------------"
echo
cat "$RESULT"
} > "$REPORTS/$TEST.md"
