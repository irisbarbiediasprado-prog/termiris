#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

EVENT="$1"
ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"

TYPE=
STATUS=
CONTEXT=

while IFS='=' read -r K V; do
    case "$K" in
        type) TYPE="$V" ;;
        status) STATUS="$V" ;;
        context) CONTEXT="$V" ;;
    esac
done < "$EVENT"

[ "$TYPE" = "TP_RESULT" ] || exit 0

SESSION="$ROOT/cache/sessions"
mkdir -p "$SESSION"

cp "$EVENT" "$SESSION/result.event"

if [ -n "${CONTEXT:-}" ] && [ -f "$CONTEXT" ]; then
    cp "$CONTEXT" "$SESSION/context.ctx"
fi

cat > "$SESSION/state" <<EOT
status=$STATUS
context=$SESSION/context.ctx
updated=$(date -Iseconds)
EOT
