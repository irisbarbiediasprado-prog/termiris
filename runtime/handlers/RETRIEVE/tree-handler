#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"
SESSION="$ROOT/cache/sessions/current"

PROJECT_ROOT="$(grep '^project_root=' "$SESSION" 2>/dev/null | cut -d= -f2- || printf '%s\n' "$HOME/.termiris")"

OUT="$ROOT/cache/tree.txt"
mkdir -p "$(dirname "$OUT")"

{
    find "$PROJECT_ROOT" \
        -path '*/.git' -prune -o \
        -path '*/node_modules' -prune -o \
        -path '*/.sandbox' -prune -o \
        -print \
    | sed "s|^$PROJECT_ROOT/||" \
    | sort
} > "$OUT"

echo "📂 Árvore salva em $OUT"
