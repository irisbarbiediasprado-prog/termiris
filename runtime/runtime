#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"

export TERMIRIS_RUNTIME="$ROOT"

BUS="$ROOT/cache/event.bus"

mkdir -p "$ROOT/cache"/{reports,sessions,notifications,metrics}
rm -f "$BUS"
mkfifo "$BUS"

"$ROOT/event-bus" < "$BUS" &
BUS_PID=$!

trap 'kill "$BUS_PID" 2>/dev/null || true; rm -f "$BUS"' EXIT

exec "$ROOT/event-parser" > "$BUS"
