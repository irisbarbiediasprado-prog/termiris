#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

while IFS= read -r LINE; do

    case "$LINE" in

        '<<RETRIEVE '*)

            CMD="${LINE#<<RETRIEVE }"
            CMD="${CMD%%>>}"

            VERB="${CMD%% *}"
            ARG="${CMD#"$VERB"}"
            ARG="${ARG# }"

            cat <<EVENT
type=RETRIEVE
verb=$VERB
arg=$ARG
EVENT
            ;;

        BOOTSTRAP_COMPLETE)

            cat <<EVENT
type=BOOTSTRAP
step=BOOTSTRAP
status=COMPLETE
EVENT
            ;;

        SPEC_PROTOCOL_COMPLETE)

            cat <<EVENT
type=BOOTSTRAP
step=SPEC_PROTOCOL
status=COMPLETE
EVENT
            ;;

        EVENTS_COMPLETE)

            cat <<EVENT
type=BOOTSTRAP
step=EVENTS
status=COMPLETE
EVENT
            ;;

        TEST_POLICY_COMPLETE)

            cat <<EVENT
type=BOOTSTRAP
step=TEST_POLICY
status=COMPLETE
EVENT
            ;;

        TP_CONFORMANCE_COMPLETE)

            cat <<EVENT
type=BOOTSTRAP
step=TP_CONFORMANCE
status=COMPLETE
EVENT
            ;;

        TP_CURRICULUM_COMPLETE)

            cat <<EVENT
type=BOOTSTRAP
step=TP_CURRICULUM
status=COMPLETE
EVENT
            ;;

        *)

            [ -n "$LINE" ] || continue

            cat <<EVENT
type=TEXT
content=$LINE
EVENT
            ;;

    esac

    echo

done
