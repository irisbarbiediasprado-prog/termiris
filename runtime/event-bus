#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="${TERMIRIS_RUNTIME:-$HOME/.termiris/runtime}"
EVENTS="$ROOT/cache/events"

mkdir -p "$EVENTS"

SEQ="$EVENTS/.seq"
[ -f "$SEQ" ] || echo 0 > "$SEQ"

next_id() {
    local n
    n=$(cat "$SEQ")
    n=$((n+1))
    echo "$n" > "$SEQ"
    printf "%06d" "$n"
}

process_event() {

    local payload="$1"

    local id
    id="$(next_id)"

    local event="$EVENTS/$id.event"

    {
        echo "id=$id"
        printf '%s\n' "$payload"
    } > "$event"

    for handler in "$ROOT"/handlers/*; do
        [ -x "$handler" ] || continue

        local block=

        while IFS= read -r line || [ -n "$line" ]; do

            if [ -z "$line" ]; then
                if [ -n "$block" ]; then
                    process_event "$block"
                    block=
                fi
                continue
            fi

            if [ -z "$block" ]; then
                block="$line"
            else
                block="$block"$'\n'"$line"
            fi

        done < <("$handler" "$event")

        [ -z "$block" ] || process_event "$block"

    done
}

while :; do

    IFS= read -r line || break
    [ -n "$line" ] || continue

    payload="$line"

    while IFS= read -r next; do
        [ -z "$next" ] && break
        payload="$payload"$'\n'"$next"
    done

    process_event "$payload"

done
